{
    "name": "MARP",
    //"dockerComposeFile": "docker-compose.yml",
    // "image": "ghcr.io/lawrence-lugs/marp/marp-tools:latest",
    "build": { 
        "dockerfile": "Dockerfile",
        "context": "..",
        "cacheFrom": "ghcr.io/lawrence-lugs/marp/marp-tools:buildcache"
    },
    "workspaceFolder": "/workspaces/MARP",
    // "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.pylance",
                "ms-toolsai.jupyter"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/miniforge/envs/marp/bin/python",
                "python.terminal.activateEnvironment": true,
                "jupyter.kernels.filter": [
                    {
                        "path": "/opt/miniforge/envs/marp/bin/python",
                        "type": "pythonEnvironment"
                    }
                ]
            }
        }
    },
    // "remoteEnv": {
    //     // Make the marp package importable from the workspace root
    //     "PYTHONPATH": "/workspace",
    //     "MPLBACKEND": "Agg"
    // },
    "postCreateCommand": "pip install -e third_party/zigzag && pip install -e '.[dev]' && echo 'Dev container ready. Run: pytest tests/'"
}
